{
  "name": "adlc-kit-ts",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @adlc-kit/server dev",
    "dev:web": "pnpm --filter @adlc-kit/web dev",
    "build": "pnpm --filter @adlc-kit/web run build",
    "typecheck": "tsc --noEmit -p packages/contracts && tsc --noEmit -p server && tsc --noEmit -p apps/web && tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ci": "tsx scripts/run-gates.ts ci-primary",
    "doc-sync": "tsx scripts/run-gates.ts doc-sync",
    "check:all": "tsx scripts/run-gates.ts check-all",
    "create": "tsx packages/create-adlc-kit-ts/bin.ts",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "jsdom": "^29.0.0",
    "lefthook": "^2.1.9",
    "oxlint": "1.76.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
